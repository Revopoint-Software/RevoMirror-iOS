#define IS_PhoneXAll [[UIApplication sharedApplication] delegate].window.safeAreaInsets.bottom > 0.0
#define RMI_StatusBarHeight                  (IS_PhoneXAll ? [UIDevice statusHeight]-11 : 0.f)
#define RMI_IPHONE_WIDTH                   [UIScreen mainScreen].bounds.size.width
#define RMI_IPHONE_HEIGHT                  [UIScreen mainScreen].bounds.size.height

#define UIColorFromRGBA(rgbValue, alphaValue) [UIColor \
colorWithRed:((float)((rgbValue & 0xFF0000) >> 16))/255.0 \
green:((float)((rgbValue & 0x00FF00) >> 8))/255.0 \
blue:((float)(rgbValue & 0x0000FF))/255.0 \
alpha:alphaValue]
#define UIColorFromRGB(rgbValue) UIColorFromRGBA(rgbValue, 1.0)

//弱引用
#define RMI_WeakSelf(weakSelf)  __weak __typeof(&*self)weakSelf = self;

#endif
